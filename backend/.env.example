# Application
APP_NAME=AI Recruitment Management System
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# PostgreSQL — Railway Postgres plugin URL works (postgres:// is auto-normalized)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/recruitment_db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# CORS — set to your Vercel production + preview origins (no trailing slash)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# Optional: allow all Vercel preview deployments
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Logging (JSON is forced in production)
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_REQUESTS=true
LOG_SKIP_PATHS=/api/v1/health,/api/v1/health/ready,/

# OpenAI (resume parsing / matching / assistant)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cloudinary (resume PDF storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hirepulse/resumes
MAX_RESUME_SIZE_MB=10

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_STATUS_CALLBACK_URL=
TWILIO_VALIDATE_SIGNATURE=true
WHATSAPP_REMINDER_HOURS=24

# Vapi AI voice screening
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
VAPI_BASE_URL=https://api.vapi.ai
VAPI_AUTO_CALL_ON_APPLY=true

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HirePulse
SMTP_USE_TLS=true

# Web Push (VAPID) — npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@hirepulse.io

# Container / Railway runtime
PORT=8000
WEB_CONCURRENCY=2
RUN_MIGRATIONS=true
