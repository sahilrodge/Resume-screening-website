# Application
APP_NAME=AI Recruitment Management System
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
# Frontend AUTH_SECRET on Vercel must equal SECRET_KEY (signs HttpOnly session cookies).
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Session (no Remember Me) vs Remember Me refresh lifetimes
REFRESH_TOKEN_SESSION_DAYS=1
REFRESH_TOKEN_REMEMBER_DAYS=30
# Legacy alias — prefer REMEMBER_DAYS above
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# Permanent Super Admin (created/promoted on API startup; cannot be deleted/demoted/suspended)
SUPER_ADMIN_EMAIL=sahilrodge4@gmail.com
SUPER_ADMIN_FULL_NAME=Super Admin
# Optional: used only when the account is created for the first time
SUPER_ADMIN_PASSWORD=

# PostgreSQL — Railway Postgres plugin URL works (postgres:// is auto-normalized)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/recruitment_db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# CORS — set to your Vercel production + preview origins (no trailing slash)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# Optional: allow all Vercel preview deployments
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Logging (JSON is forced in production)
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_REQUESTS=true
LOG_SKIP_PATHS=/api/v1/health,/api/v1/health/ready,/

# OpenAI (resume parsing / matching / assistant)
# Required for AI features. Get a key from https://platform.openai.com/api-keys
# Example: OPENAI_API_KEY=sk-...
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cloudinary (optional resume/avatar storage)
# Read from env: CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
# If any are missing, the API falls back to local file storage (LOCAL_UPLOAD_DIR)
# and will not crash. Set all three to enable Cloudinary uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hirepulse/resumes
MAX_RESUME_SIZE_MB=10
LOCAL_UPLOAD_DIR=uploads
# Optional absolute API origin used when building local download URLs
PUBLIC_API_URL=http://127.0.0.1:8000
# Absolute frontend origin for email deep links (production Vercel URL)
FRONTEND_URL=https://hirepulse-gamma.vercel.app

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HirePulse
SMTP_USE_TLS=true

# Web Push (VAPID) — npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@hirepulse.io

# Container / Railway runtime
PORT=8000
WEB_CONCURRENCY=2
RUN_MIGRATIONS=true
# Demo job seed — keep false in production (seeded recruiters use a known password)
SEED_JOBS_IF_EMPTY=false
