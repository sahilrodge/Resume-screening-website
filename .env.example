# Shared compose / local production overrides (optional)
# Copy values into backend/.env and Vercel/Railway dashboards for real deploys.

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=HirePulse

# Frontend middleware session cookie (must match backend SECRET_KEY, min 32 chars)
AUTH_SECRET=change-me-to-a-long-random-secret-key-min-32-chars

# Backend: set the same value as SECRET_KEY, and lock CORS to your frontend origins
# SECRET_KEY=<same as AUTH_SECRET>
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
